# Local development: call the API directly (full base URL including /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production (Vercel): proxy the API through this site so auth cookies are first-party.
#   NEXT_PUBLIC_API_URL=/api/v1
#   API_PROXY_TARGET=https://<your-backend>.vercel.app
# Both are read at build time, so redeploy after changing them.

# Optional, server-only. Same value as REVALIDATE_SECRET in the API.
REVALIDATE_SECRET=
